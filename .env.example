# Copy to .env for local development. Never commit .env.
# Shared core (CAUTO_ prefix, "__" separates nested keys):
# CAUTO_ENVIRONMENT=dev
# CAUTO_LOGGING__LEVEL=DEBUG
# CAUTO_REPORTING__JSON_ENABLED=true
# CAUTO_EXECUTION__RUN_ID=
# CAUTO_SECURITY__REDACT_KEYS=["x_internal_token"]

# Database module (modules.database; secrets only here or in the environment, never in YAML):
# CAUTO_MODULES__DATABASE__USERNAME=
# CAUTO_MODULES__DATABASE__PASSWORD=
# CAUTO_MODULES__DATABASE__HOST=127.0.0.1
# CAUTO_MODULES__DATABASE__PORT=5432
# CAUTO_MODULES__DATABASE__URL=            # alternative to the fields above; contains the password

# UI module (modules.ui; see docs/ui_automation.md). No application credentials here: read them in your tests.
# CAUTO_MODULES__UI__BASE_URL=http://127.0.0.1:3000
# CAUTO_MODULES__UI__BROWSER=chromium       # chromium | firefox | webkit
# CAUTO_MODULES__UI__HEADLESS=true
# CAUTO_MODULES__UI__TRACE=off              # off | on_failure | always (traces can contain cookies and headers)
# CAUTO_MODULES__UI__VIDEO=off

# LLM evaluation module (modules.llm_evaluation; see docs/llm_evaluation.md). No secrets: it only talks to your Ollama.
# CAUTO_MODULES__LLM_EVALUATION__BASE_URL=http://localhost:11434
# CAUTO_MODULES__LLM_EVALUATION__MODEL=          # a name from `ollama list`; never defaulted
# CAUTO_MODULES__LLM_EVALUATION__JUDGE_MODEL=    # optional, independent of the model under test
# CAUTO_MODULES__LLM_EVALUATION__LIVE=false      # true enables the tests that call a real model
# CAUTO_MODULES__LLM_EVALUATION__REQUIRE_MODEL=false   # true: an unavailable model fails instead of skipping
# CAUTO_MODULES__LLM_EVALUATION__PERSIST_RAW=true      # false: reports keep scores, not prompts or responses

# Older DeepEval suite (read directly by tests/llm):
# OPENAI_API_KEY=                  # DeepEval's default judge; without it tests/llm is skipped
# CONFIDENT_API_KEY=
# DEEPEVAL_MODEL=gpt-4.1
# CONFIDENT_ALIAS=llm-regression-suite
